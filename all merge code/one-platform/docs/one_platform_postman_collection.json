            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"London\",\n  \"group\": \"Economy\",\n  \"rental_length\": 2,\n  \"start_date\": \"2023-07-25\",\n  \"start_time\": \"10:00\",\n  \"return_date\": \"2023-07-27\",\n  \"return_time\": \"10:00\",\n  \"window_pct\": 0.5,\n  \"step_gbp\": 5\n}"
