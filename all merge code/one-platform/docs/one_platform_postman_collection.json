    { "key": "airbnbApiBase", "value": "{{baseUrl}}/api/airbnb" },
    { "key": "apiKey", "value": "" },
    { "key": "adminKey", "value": "" },
    { "key": "airbnbToken", "value": "" },
    { "key": "listingId", "value": "1" },
