          "name": "Quote",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}", "disabled": true }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"London\",\n  \"group\": \"Economy\",\n  \"rental_length\": 2,\n  \"start_date\": \"2023-07-25\",\n  \"start_time\": \"10:00\",\n  \"return_date\": \"2023-07-27\",\n  \"return_time\": \"10:00\"\n}"
            },
            "url": "{{carApiBase}}/quote"
          }
