        {
          "name": "Pricing Calendar",
          "request": { "method": "GET", "header": [], "url": "{{carApiBase}}/pricing-calendar?listingId={{listingId}}&days=30" }
        },
        {
          "name": "Pricing Signals",
          "request": { "method": "GET", "header": [], "url": "{{carApiBase}}/pricing-signals?listingId={{listingId}}" }
        },
        {
          "name": "Demand Data",
          "request": { "method": "GET", "header": [], "url": "{{carApiBase}}/demand-data?listingId={{listingId}}&days=30" }
        },
        {
          "name": "Override Price",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"date\": \"2026-05-10\",\n  \"price\": 99,\n  \"reason\": \"manual adjustment\"\n}"
            },
            "url": "{{carApiBase}}/override-price"
