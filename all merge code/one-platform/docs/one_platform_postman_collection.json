    {
      "name": "Airbnb API (via /api/airbnb)",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "header": [], "url": "{{airbnbApiBase}}/health" }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
            },
            "url": "{{airbnbApiBase}}/auth/login"
          }
        },
        {
          "name": "Listings",
          "request": { "method": "GET", "header": [], "url": "{{airbnbApiBase}}/listings?limit=50" }
        },
        {
          "name": "Pricing by Listing",
          "request": { "method": "GET", "header": [], "url": "{{airbnbApiBase}}/pricing/{{listingId}}" }
        },
        {
          "name": "Save Host Settings",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{airbnbToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"smart_pricing_enabled\": true,\n  \"min_price\": 30,\n  \"max_price\": 300,\n  \"base_price\": 120,\n  \"pricing_goal\": \"balanced\",\n  \"risk_tolerance\": \"medium\",\n  \"update_frequency\": \"daily\",\n  \"discount_floor_protection\": true,\n  \"locked_dates\": [],\n  \"blackout_dates\": []\n}"
            },
            "url": "{{airbnbApiBase}}/host/settings/{{listingId}}"
          }
        },
        {
          "name": "Simulation Run",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listing_id\": \"{{listingId}}\",\n  \"custom_price\": 150\n}"
            },
            "url": "{{airbnbApiBase}}/simulation/run"
          }
        },
        {
          "name": "Admin Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{airbnbToken}}" }],
            "url": "{{airbnbApiBase}}/admin/status"
          }
        },
