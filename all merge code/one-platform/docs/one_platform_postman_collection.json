    {
      "name": "Car API (via /api)",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "header": [], "url": "{{carApiBase}}/health" }
        },
        {
          "name": "Listings",
          "request": { "method": "GET", "header": [], "url": "{{carApiBase}}/listings" }
        },
        {
          "name": "Listing By ID",
          "request": { "method": "GET", "header": [], "url": "{{carApiBase}}/listing/{{listingId}}" }
        },
        {
          "name": "Listing Settings",
          "request": { "method": "GET", "header": [], "url": "{{carApiBase}}/listing/{{listingId}}/settings" }
        },
        {
          "name": "Update Listing Settings",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"minPrice\": 45,\n  \"maxPrice\": 250,\n  \"smartPricingEnabled\": true,\n  \"discounts\": {\n    \"weekly\": 10,\n    \"monthly\": 20\n  }\n}"
            },
            "url": "{{carApiBase}}/listing/{{listingId}}/settings"
          }
        },
        {
          "name": "Pricing Try Values",
          "request": { "method": "GET", "header": [], "url": "{{carApiBase}}/pricing-try-values?listingId={{listingId}}" }
