          "name": "Admin Kill Switch",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{airbnbToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"enabled\": false,\n  \"region\": null\n}" },
            "url": "{{airbnbApiBase}}/admin/kill-switch"
          }
        }
      ]
